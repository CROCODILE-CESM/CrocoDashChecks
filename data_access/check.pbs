#!/bin/bash
#PBS -N croc_data_access
#PBS -A NCGD0011
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -l walltime=01:30:00
#PBS -j oe
#
# Daily data-access check on GLADE: check.py with the CrocoDash env
# and your credentials (~/.cdsapirc, ~/.copernicusmarine), so the checks that
# read GLADE (GLORYS from RDA, CESM output, the CICE restart) can pass too.
#
#   qsub -q casper@casper-pbs data_access/check.pbs
#
# cron_submit.sh submits this daily; see README.md.
#
# CONDA_ENV     : conda env with CrocoDash installed (default: CrocoDash)
# CROCODASH_SRC : optional CrocoDash checkout (with submodules) to check instead of
#                 the one installed in CONDA_ENV. It is not updated here; the weekly
#                 CESM-run job keeps it at its branch tip.
# UPDATE        : if set, reset this repo to its branch tip first
# PUBLISH       : if set, push data_access/health.json to main, which rebuilds the site
set -euo pipefail

CONDA_ENV=${CONDA_ENV:-CrocoDash}
REPO_ROOT=$(git -C "$PBS_O_WORKDIR" rev-parse --show-toplevel)

module load conda
conda activate "$CONDA_ENV"
# ESMF ships with the conda env; don't mix in a system ESMF module.
export ESMFMKFILE=$CONDA_PREFIX/lib/esmf.mk

if [ -n "${UPDATE:-}" ]; then
  git -C "$REPO_ROOT" fetch -q && git -C "$REPO_ROOT" reset -q --hard '@{u}'
fi

if [ -n "${CROCODASH_SRC:-}" ]; then
  S=$CROCODASH_SRC/CrocoDash
  export PYTHONPATH=$CROCODASH_SRC:$S/rm6:$S/visualCaseGen:$S/visualCaseGen/ProConPy:$S/visualCaseGen/external/mom6_forge:$S/visualCaseGen/external/ipyfilechooser:$CROCODASH_SRC/gallery${PYTHONPATH:+:$PYTHONPATH}
fi
python -c "import CrocoDash; print('CrocoDash from', CrocoDash.__file__)"

cd "$REPO_ROOT"
python data_access/check.py || true

if [ -n "${PUBLISH:-}" ]; then
  OUT=$(mktemp -d)
  cp data_access/health.json "$OUT/"
  BRANCH=main DEST=data_access MSG="Daily data-access health $(date +%F)" \
    bash cesm_runs/push_results.sh "$OUT"
fi
