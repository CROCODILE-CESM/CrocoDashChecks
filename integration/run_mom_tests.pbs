#!/bin/bash
#PBS -N croc_mom_tests
#PBS -A NCGD0011
#PBS -q main
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l walltime=06:00:00
#PBS -j oe
#
# Runs run_mom_tests.py on one Derecho node: CrocoDash forcing generation (the
# GLOFAS runoff map) needs more memory than a login node allows, and
# case.submit --no-batch runs the model right here. Tests run one at a time
# (every GLOFAS-runoff case needs tens of GB, and five at once overran 200 GB):
# 4 MPI tasks for the small ocean, ice and wave grids, 56 for the data
# atmosphere, data runoff and mediator, which read global data.
#
#   qsub -v CESMROOT=~/CESM_crocodash run_mom_tests.pbs
#
# weekly.sh submits this every week, with a CESMROOT that doesn't exist yet.
#
# CESMROOT  : a checkout of CROCODILE-CESM/CESM branch `crocodash` (required); if it
#             doesn't exist, the tip of that branch is cloned there first
# CONDA_ENV : conda env with CrocoDash's dependencies (default: CrocoDash)
# TESTROOT  : where test dirs go (default: /glade/derecho/scratch/$USER/croc_tests)
# CROCODASH_BRANCH : CrocoDash branch to test (default: main). Every run checks out
#                    a fresh clone of it, so it always tests that branch's tip.
# PUBLISH   : if set, push cesm_runs.json (the dashboard's summary) to the test-results branch
# EXTRA     : extra args for run_mom_tests.py, e.g. "--only MARBL"
set -euo pipefail

: "${CESMROOT:?set CESMROOT to a CESM checkout of branch crocodash}"
CONDA_ENV=${CONDA_ENV:-CrocoDash}
TESTROOT=${TESTROOT:-/glade/derecho/scratch/$USER/croc_tests}

module load conda
conda activate "$CONDA_ENV"
# ESMF ships with the conda env; don't mix in a system ESMF module.
export ESMFMKFILE=$CONDA_PREFIX/lib/esmf.mk

if [ ! -d "$CESMROOT" ]; then
  git clone -q -b crocodash https://github.com/CROCODILE-CESM/CESM "$CESMROOT"
  (cd "$CESMROOT" && ./bin/git-fleximod update)
fi

# A fresh clone of CrocoDash main (or CROCODASH_BRANCH), first on PYTHONPATH,
# deleted when the job ends (the cases don't read it once created).
# run_mom_tests.py records its branch and commit.
mkdir -p "$TESTROOT"
CLONE_ROOT=$TESTROOT
source "$PBS_O_WORKDIR/../crocodash_main.sh"
python -c "import CrocoDash, regional_mom6; print('CrocoDash from', CrocoDash.__file__)"

cd "$PBS_O_WORKDIR"
RESULTS=$TESTROOT/results.$PBS_JOBID
python run_mom_tests.py --cesmroot "$CESMROOT" --test-root "$TESTROOT" --parallel 1 --ntasks 4 --data-ntasks 56 \
  --results-dir "$RESULTS" ${EXTRA:-}

if [ -n "${PUBLISH:-}" ]; then
  bash ../push_results.sh "$RESULTS"
fi
