#!/bin/bash
# Runs test_workflow.py on Casper against a fresh clone of CrocoDash main, and
# writes integration/workflow.json (the timings) and workflow.xml (what passed,
# failed or was skipped, and why) in this checkout. cron_submit.sh submits it
# weekly; by hand, from the repo root:
#   qsub -q casper@casper-pbs integration/workflow.pbs
# PYTEST_ARGS adds pytest options, e.g. to run only the poles:
#   qsub -q casper@casper-pbs -v PYTEST_ARGS="-k pole" integration/workflow.pbs
#
# UPDATE  : if set, reset this repo to its branch tip first
# PUBLISH : if set, push workflow.json and workflow.xml to main, which rebuilds the site
#PBS -N crocodashchecks_workflow
#PBS -A NCGD0011
#PBS -l select=1:ncpus=16:mem=180GB
#PBS -l walltime=08:00:00
#PBS -j oe
set -uo pipefail
REPO_ROOT=$(git -C "$PBS_O_WORKDIR" rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1
if [ -n "${UPDATE:-}" ]; then
  git fetch -q && git reset -q --hard '@{u}' || exit 1
fi
module load conda
conda activate CrocoDash
export ESMFMKFILE=$CONDA_PREFIX/lib/esmf.mk
export TMPDIR=/glade/derecho/scratch/$USER/crocodashchecks_workflow.$PBS_JOBID
CLONE_ROOT=$TMPDIR
RESULTS=$TMPDIR/results
mkdir -p "$RESULTS"
source crocodash_main.sh || exit 1
# shellcheck disable=SC2086  # PYTEST_ARGS is meant to split into options
python -m pytest -p no:cacheprovider -rfEs --basetemp="$TMPDIR/pytest" ${PYTEST_ARGS:-} \
    integration/test_workflow.py \
    --benchmark-json="$RESULTS/workflow.json" --junitxml="$RESULTS/workflow.xml"
status=$?
cp "$RESULTS"/workflow.* integration/
if [ -n "${PUBLISH:-}" ]; then
  BRANCH=main DEST=integration MSG="Weekly workflow results $(date +%F)" \
    bash push_results.sh "$RESULTS" || status=1
fi
rm -rf "$TMPDIR"
exit $status
